__pycache__/
*.pyc
.venv/
env/
*.pth
*.ckpt
*.safetensors
models/
weights/

# 派生素材可由 scripts/make_derived.py 确定性重建，不入库
assets/derived/

# 母版可由 scripts/fetch_assets.py 按 manifest.json + SHA256 确定性重建，不入库
assets/raw/*.mp4

# 中间产物（ASS 字幕等）
_work/

# 跑分产物的中间视频（每 case 数百 MB 无损 mkv，可由 eval/runner.py 重建）
# 注意：results/<run_id>/ 下的 metrics.jsonl / table.md / badcases.md / regression.md
#       是「跑分可复现」的证据链，保留入库
results/*/work/

# 本地密钥，不入库
.env

# 人评成片（体积大，可由 make_items.py 重建）
results/human_review/items/*.mp4

# 场景成片与配音轨（合计 ~100 MB，可由 scripts/scenario_demo.py 重建；
# 证据链是每个场景的 run.json + subtitles.srt/ass + 对比表，入库）
results/scenarios/**/*.mp4
results/scenarios/**/*.wav
